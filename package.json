{
  "name": "mentalix",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run preview:telegram",
    "preview:telegram": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/preview-telegram.ps1",
    "preview:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/preview-stop.ps1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "node --test tests/unit/maintenance-contracts.test.mjs tests/unit/journal-markdown.test.mjs",
    "ux:check": "playwright test --config=playwright.ux.config.mjs",
    "format": "prettier --write .",
    "prepare": "husky",
    "preview:stop:dry-run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/preview-stop.ps1 -DryRun"
  },
  "dependencies": {
    "@twa-dev/sdk": "7.10.1",
    "lucide-react": "0.454.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "8.4.47",
    "prettier": "^3.9.6",
    "tailwindcss": "3.4.13",
    "vite": "5.4.11"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
