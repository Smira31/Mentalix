{
  "name": "mentalix",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run preview:web",
    "preview:web": "vite preview --host 127.0.0.1 --port 4174",
    "preview:telegram": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/preview-telegram.ps1",
    "preview:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/preview-stop.ps1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:drift": "node scripts/docs-drift.mjs",
    "doctor": "node scripts/project-doctor.mjs",
    "ux:check": "playwright test --config=playwright.ux.config.mjs",
    "test:design-guard": "node scripts/design-guard.mjs",
    "ux:mazelogo": "playwright test --config=playwright.mazelogo.config.mjs",
    "ux:mxl010": "playwright test --config=playwright.mxl010.config.mjs",
    "ux:mxl246": "playwright test --config=playwright.mxl246.config.mjs",
    "ux:daily-canonical": "playwright test --config=playwright.mxl-daily-canonical-ui-lab-001.config.mjs",
    "test:gate": "npm run lint && npm run test:unit && npm run build && npm run ux:check",
    "test:visual:update": "playwright test --config=playwright.ux.config.mjs --update-snapshots",
    "check:core": "npm run test:unit && npm run lint && npm run build && npm run docs:check",
    "format": "prettier --write .",
    "prepare": "husky",
    "preview:stop:dry-run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/preview-stop.ps1 -DryRun"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@tanstack/react-query": "^5.102.8",
    "@twa-dev/sdk": "7.10.1",
    "lucide-react": "0.454.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "3.4.13",
    "vite": "^8.2.2"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
